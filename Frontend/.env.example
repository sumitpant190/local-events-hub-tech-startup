# Copy to .env and edit. Restart `npm start` after changing it.
# EXPO_PUBLIC_* values are inlined into the app bundle: never put secrets here.

# true (default) = in-memory mock backend; false = real API at EXPO_PUBLIC_API_URL
EXPO_PUBLIC_USE_MOCK_DATA=true

# Base URL of the real backend, no trailing slash. Required when USE_MOCK_DATA is false.
# From an Android emulator, your PC's localhost is 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
