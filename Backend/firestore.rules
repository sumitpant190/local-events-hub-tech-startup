rules_version = '2';

// Deny by default; every access below is an explicit grant. There is no server and no custom claims
// (Spark plan), so these rules are the whole access-control layer and roles come from users/{uid}.role.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The caller's role, read live from their own profile (one document read). Only an admin can ever
    // write a role, so this is trustworthy; a missing profile makes the get() fail and the rule deny.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    function isOrganizerOrAdmin() {
      return isSignedIn() && callerRole() in ['organizer', 'admin'];
    }

    function hasExactly(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    function isNonBlankString(value, maxSize) {
      return value is string && value.trim().size() > 0 && value.size() <= maxSize;
    }

    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    // attendeeCount delta for an RSVP status change: +1 joining, -1 leaving, 0 otherwise.
    function goingDelta(wasGoing, isGoing) {
      return wasGoing == isGoing ? 0 : (isGoing ? 1 : -1);
    }

    // The caller's own RSVP before (get) and after (getAfter) the current commit.
    function callerWasGoing(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid);
      return exists(path) && get(path).data.status == 'going';
    }

    function callerWillBeGoing(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid);
      return existsAfter(path) && getAfter(path).data.status == 'going';
    }

    // The event's counter (attendeeCount / commentCount) after this commit equals the stored value plus `delta`.
    function counterMovesBy(eventId, field, delta) {
      let path = /databases/$(database)/documents/events/$(eventId);
      return getAfter(path).data[field] == get(path).data[field] + delta;
    }

    // ---------- users ----------

    function isValidProfile(data) {
      return hasExactly(data, ['name', 'email', 'role', 'avatarUrl'])
        && isNonBlankString(data.name, 80)
        && data.email is string
        && data.role in ['attendee', 'organizer', 'admin']
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 2048;
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      // Signup: own uid only, own login email, and always attendee (no self-created organizers/admins).
      allow create: if isSelf(userId)
        && isValidProfile(request.resource.data)
        && request.resource.data.role == 'attendee'
        && request.resource.data.email == request.auth.token.email;

      // Self-edit may never touch role (no self-promotion) and may only change name/avatarUrl.
      // Admins may change role (in-app promotion). Email is fixed for everyone: it mirrors the Auth account.
      allow update: if isValidProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && (
          (isSelf(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl']))
          || isAdmin()
        );
    }

    // ---------- events ----------

    function isValidEvent(data) {
      return hasExactly(data, ['title', 'description', 'date', 'location', 'category', 'organizerId',
                               'attendeeCount', 'commentCount', 'imageUrl'])
        && isNonBlankString(data.title, 120)
        && isNonBlankString(data.description, 5000)
        && data.date is timestamp
        && isNonBlankString(data.location, 200)
        && data.category in ['Hackathon', 'Networking', 'Pitch Night', 'Workshop', 'Demo Day', 'Panel']
        && data.organizerId is string
        && data.attendeeCount is int && data.attendeeCount >= 0
        && data.commentCount is int && data.commentCount >= 0
        && data.imageUrl is string
        && data.imageUrl.size() <= 2048;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();

      // Organizers create events as themselves (admins for anyone), with counters starting at zero.
      allow create: if isOrganizerOrAdmin()
        && isValidEvent(request.resource.data)
        && (request.resource.data.organizerId == request.auth.uid || isAdmin())
        && request.resource.data.attendeeCount == 0
        && request.resource.data.commentCount == 0;

      // Owner (or admin) edits. Ownership can't be handed off except by an admin, and the counters are
      // never editable here: they only move with RSVPs and comments.
      allow update: if isOrganizerOrAdmin()
        && (resource.data.organizerId == request.auth.uid || isAdmin())
        && isValidEvent(request.resource.data)
        && (request.resource.data.organizerId == resource.data.organizerId || isAdmin())
        && request.resource.data.attendeeCount == resource.data.attendeeCount
        && request.resource.data.commentCount == resource.data.commentCount;

      // RSVP counter: any signed-in user may move ONLY attendeeCount, by exactly the change their own
      // RSVP undergoes in the same commit. Compared against the stored count, so stale writes fail.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount'])
        && request.resource.data.attendeeCount != resource.data.attendeeCount
        && request.resource.data.attendeeCount >= 0
        && request.resource.data.attendeeCount
             == resource.data.attendeeCount + goingDelta(callerWasGoing(eventId), callerWillBeGoing(eventId));

      // Comment counter: any signed-in user may move ONLY commentCount, by exactly +1/-1 from the stored
      // value. The comment rules below require that move whenever a comment is created or deleted.
      // ponytail: comment ids are random, so this rule can't verify a comment exists in the same commit;
      // a tampered client can nudge the count by 1 per write without commenting. Closing it needs a
      // server trigger (Blaze) or deterministic comment ids.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount - resource.data.commentCount in [1, -1]
        && request.resource.data.commentCount >= 0;

      allow delete: if isOrganizerOrAdmin()
        && (resource.data.organizerId == request.auth.uid || isAdmin());

      // ---------- events/{eventId}/rsvps/{userId} ----------

      match /rsvps/{userId} {
        allow read: if isSignedIn();

        // Only your own RSVP (doc id == your uid), on an existing event, with a server timestamp, and
        // committed together with the matching attendeeCount change (see the events counter rule).
        // No delete: cancelling is status "not_going", so the RSVP always pairs with the attendee count.
        allow create, update: if isSelf(userId)
          && eventExists(eventId)
          && hasExactly(request.resource.data, ['status', 'updatedAt'])
          && request.resource.data.status in ['going', 'not_going']
          && request.resource.data.updatedAt == request.time
          && counterMovesBy(eventId, 'attendeeCount', goingDelta(
               resource != null && resource.data.status == 'going',
               request.resource.data.status == 'going'));
      }

      // ---------- events/{eventId}/comments/{commentId} ----------

      match /comments/{commentId} {
        allow read: if isSignedIn();

        // Post as yourself only: non-blank text under 500 characters, server timestamp, and committed
        // together with commentCount +1 (so the count can't drift from the real number of comments).
        allow create: if isSignedIn()
          && eventExists(eventId)
          && hasExactly(request.resource.data, ['userId', 'text', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() > 0
          && request.resource.data.text.size() < 500
          && request.resource.data.createdAt == request.time
          && counterMovesBy(eventId, 'commentCount', 1);

        // Comments are immutable: no update rule. Only the author or an admin can delete, with commentCount -1.
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin())
          && counterMovesBy(eventId, 'commentCount', -1);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
