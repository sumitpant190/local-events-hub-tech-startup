# Copy to .env and edit. Restart `npm start` after changing it.
# EXPO_PUBLIC_* values are inlined into the app bundle: never put secrets here.

# Dev builds use the local Firebase emulators by default (Backend: `npm run emulators`, then
# `npm run seed:emulator`). Set to false to point a dev build at the real Firebase project.
# Release builds always use the real project, whatever this says.
EXPO_PUBLIC_USE_EMULATOR=true

# Host running the emulators, as seen from the device. Leave unset for the defaults:
# Android emulator → 10.0.2.2, iOS simulator / web → localhost.
# A physical phone needs your computer's LAN IP, e.g. 192.168.1.20 (same Wi-Fi).
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20
